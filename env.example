# --- Shippo (connects to USPS, UPS, DHL, DHL eCommerce, FedEx) ---
# Get this from https://apps.goshippo.com/settings/api  (start with the TEST key, switch to LIVE later)
SHIPPO_API_KEY=shippo_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Shop origin address (used as "ship from" on every rate quote) ---
SHOP_NAME=Buddhabhumi Pvt. Li.
SHOP_STREET1=C/ Industria 124
SHOP_CITY=Barcelona
SHOP_ZIP=08025
SHOP_COUNTRY=ES
SHOP_PHONE=+34632787437
SHOP_EMAIL=orders@yourdomain.com

# --- Outgoing email (order notifications) — any SMTP account works ---
# Example with Gmail: create an "App Password" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-app-password
NOTIFY_EMAIL=orders@yourdomain.com

# --- Admin access for /api/orders and the admin page ---
ADMIN_KEY=choose-a-long-random-password

# --- CORS: the exact URL(s) where your storefront HTML is hosted ---
ALLOWED_ORIGIN=*

# --- Stripe (card payment) ---
# Get this from https://dashboard.stripe.com/test/apikeys (use the TEST secret key first)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get this after creating a webhook endpoint at https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The exact URL where your storefront HTML is published (used to send the
# customer back after paying). Example: https://your-username.github.io/your-repo/
STORE_URL=https://your-username.github.io/your-repo/

PORT=3000
